# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    lray Upstream Forwarder Config                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Domain / IP ──────────────────────────────────────────────────────────────
# Your server's domain name or IP address
# Examples: myserver.com, 185.100.50.25
DOMAIN=example.com

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret key shared between Cloudflare Worker and this forwarder (min 32 chars)
# MUST match UPSTREAM_AUTH_KEY in your Cloudflare Worker settings
AUTH_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ─── Forwarder Settings ──────────────────────────────────────────────────────
# Internal port for forwarder nodes (usually no need to change)
FORWARDER_PORT=8787

# Number of forwarder instances to run (more = handles more traffic)
FORWARDER_REPLICAS=2

# Max request body size in MB
MAX_BODY_MB=50

# Timeout for fetching target websites (milliseconds)
FETCH_TIMEOUT_MS=30000

# Max requests per minute per IP (0 = unlimited)
RATE_LIMIT_RPM=300

# Log each request? (true/false)
LOG_REQUESTS=true

# ─── Protocol ────────────────────────────────────────────────────────────────
# Mode: http, https, both, or auto
#   auto = if domain + SSL available → HTTPS, if IP → HTTP only
#   http = only HTTP
#   https = only HTTPS
#   both = HTTP + HTTPS
PROTOCOL_MODE=auto

# ─── Ports ────────────────────────────────────────────────────────────────────
# External ports your server listens on
HTTP_PORT=80
HTTPS_PORT=443

# ─── SSL Settings ────────────────────────────────────────────────────────────
# Mode: letsencrypt, own, or none
#   letsencrypt = auto-obtain free SSL cert (needs real domain, not IP)
#   own = use your own certificate files
#   none = no SSL, HTTP only
SSL_MODE=letsencrypt

# Email for Let's Encrypt (required if SSL_MODE=letsencrypt)
LETSENCRYPT_EMAIL=user@example.com

# Your own cert paths (required if SSL_MODE=own)
SSL_CERT_FILE=./certs/fullchain.pem
SSL_KEY_FILE=./certs/privkey.pem

# ─── Resource Limits ─────────────────────────────────────────────────────────
# Max memory per forwarder node (e.g. 256m, 512m, 1g)
MEM_LIMIT=512m

# Max CPU per forwarder node (e.g. 0.5 = half a core, 1.0 = one core)
CPU_LIMIT=1.0

# ─── Cloudflare IP Whitelist ─────────────────────────────────────────────────
# Only allow requests from Cloudflare Worker IPs? (true/false)
# If true, only Cloudflare's IP ranges can reach /fwd endpoint
# If false, any IP with valid AUTH_KEY can connect
CF_IP_WHITELIST=false

# ─── Exit Proxy (optional) ───────────────────────────────────────────────────
# Route outbound fetch through an external proxy for extra anonymity
# Leave empty for direct fetch (default)
# Format: http://user:pass@host:port or http://host:port
EXIT_PROXY_URL=

# ─── Dashboard Auth ──────────────────────────────────────────────────────────
# Username and password for /dashboard access
# Leave DASHBOARD_PASS empty to disable auth (open access)
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme
