# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║              Self-Hosted Exit Node — Cloudflare Worker Alternative           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# This replaces Cloudflare Worker entirely.
# GAS sends requests directly to this server instead of a Worker.
#
# Architecture:
#   Client → Local Proxy → GAS → THIS SERVER → Target Website
#

# ─── Authentication ───────────────────────────────────────────────────────────
# Must match the WORKER_URL auth in Code.gs
# (GAS doesn't send auth header to worker, it's embedded in the request)
AUTH_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_BODY_MB=100
FETCH_TIMEOUT_MS=30000
RATE_LIMIT_RPM=300

# ─── Exit Proxy (optional) ───────────────────────────────────────────────────
# Route all outbound fetches through another proxy
# Format: http://user:pass@host:port
EXIT_PROXY_URL=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_REQUESTS=true
