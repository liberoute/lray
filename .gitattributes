# Force LF line endings for scripts and configs that run on Linux
*.sh text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf

# Keep Windows scripts with CRLF
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
